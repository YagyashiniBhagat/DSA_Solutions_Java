class Solution {
    public int smallestNumber(int n, int t) {
        while(true){
            int prod=1;
            int x=n;
            while(x!=0){
                int lastdigit=x%10;
                prod*=lastdigit;
                x/=10;
            }
            if(prod%t==0) return n;
            n++;
        }
    }
}
