class Solution {
    public int minimumPushes(String word) {
        // if(word.length()==8) return word.length();

        // Map<Integer,Integer> map=new HashMap<>();
        // int assign=2,c=0;
        // for(char ch:word.toCharArray()){
        //     if(assign>9) assign=2;
        //     map.put(assign,map.getOrDefault(assign,0)+1);
        //     c+=map.get(assign);
        //     assign++;
        // }
        // return c;

        int[] mp=new int[26];
        for(char ch:word.toCharArray()) mp[ch-'a']++;//build frequency array
        Integer[] mpInteger=Arrays.stream(mp).boxed().toArray(Integer[]::new);
        Arrays.sort(mpInteger,Comparator.reverseOrder());

        int c=0;
        for(int i=0;i<26;i++){
            c+=mpInteger[i]*(i/8 + 1);
        }
        return c;
    }
}
