class Solution {

    long gcd(long a, long b){
        return (b==0) ? a: gcd(b,a%b);
    }
    
    long countsmaller(long mid, int[] coins){
        long correctedcnt=0;
        int n=coins.length;
        for(int exp=1;exp <= (1<<n)-1 ; exp++){
            long order=0,lcm=0;
            for(int i=0;i<n;i++){
                if((exp & (1<<i))!=0){
                    order++;
                    if(lcm==0) lcm=coins[i];
                    else{
                        lcm=lcm*coins[i] / gcd(lcm,coins[i]);
                    }
                }
            }
            if(order%2==0) correctedcnt-=mid/lcm;
            else correctedcnt+=mid/lcm;
        }
        return correctedcnt;
    }

    public long findKthSmallest(int[] coins, int k) {
        long res=-1;
        int maxcoin=0;
        for(int coin:coins) maxcoin=Math.max(maxcoin,coin);
        long l=1, r=(long) maxcoin*k;
        while(l<=r){
            long mid=l+(r-l)/2;
            if(countsmaller(mid,coins) >= k){
                res=mid;
                r=mid-1;
            }
            else l=mid+1;
        }
        return res;
    }
}
