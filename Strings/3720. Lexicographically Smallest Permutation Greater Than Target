class Solution {
    String res="";
    boolean helper(int[] freq,String target,StringBuilder curr,int i,boolean greater){
        if(i==target.length()){
            if(greater){
                res=curr.toString();
                return true;
            }
            return false;
        }
        for(char ch='a';ch<='z';ch++){
            if(freq[ch-'a']==0) continue;
            if(greater==false && ch<target.charAt(i)) continue;
            //do
            curr.append(ch);
            freq[ch-'a']--;
            //explore
            boolean isgreater=greater || ch>target.charAt(i);
            if(helper(freq,target,curr,i+1,isgreater)) return true;
            //undo
            curr.deleteCharAt(curr.length()-1);
            freq[ch-'a']++;
        }
        return false;
    }
    public String lexGreaterPermutation(String s, String target) {
        StringBuilder curr=new StringBuilder();
        int[] freq=new int[26];
        for(char ch:s.toCharArray()) freq[ch-'a']++;
        helper(freq,target,curr,0,false);
        return res;
    }
}
