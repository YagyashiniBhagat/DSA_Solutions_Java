class Solution {
    public String smallestPalindrome(String s) {
        int n=s.length();
        if(n==1) return s;
        int mid=n/2;
        char[] chars=s.toCharArray();
        Arrays.sort(chars,0,mid);
        for(int i=0;i<mid;i++){
            chars[n-i-1]=chars[i];
        }
        return new String(chars);
    }
}
