TC: O(n+m)
SC: O(n)

class Solution {
    public int[] validSequence(String word1, String word2) {
        int n=word1.length(),m=word2.length();
        int[] rhsmatched=new int[n+1];
        int[] ans=new int[m];
        int nomatchedrhs=0,y=m-1;
        for(int x=n-1;x>=0;x--){
            if(y>=0 && word1.charAt(x)==word2.charAt(y)){
                nomatchedrhs++;
                y--;
            }
            rhsmatched[x]=nomatchedrhs;
        }
        boolean changepower=true;
        int i=0,j=0;
        while(i<n && j<m){
            if(word1.charAt(i)==word2.charAt(j)){
                ans[j]=i;
                j++;
            }
            else if(changepower==true && rhsmatched[i+1]>=m-j-1){
                ans[j]=i;
                changepower=false;
                j++;
            }
            i++;
        }
        return (j==m) ? ans : new int[0];
    }
}
