class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        int i=0,n=s.length(),ones=0;
        String res="";
        for(int j=0;j<n;j++){
            if(s.charAt(j)=='1') ones++;
            while(i<=j && (ones>k || s.charAt(i)=='0')){
                if(s.charAt(i)=='1') ones--;
                i++;
            }
            if(ones==k){
                String temp=s.substring(i,j+1);
                if(res.isEmpty() || res.length() > temp.length() || (res.length() == temp.length() && temp.compareTo(res)<0)) res=temp;
            }
        }
        return res;
    }
}
