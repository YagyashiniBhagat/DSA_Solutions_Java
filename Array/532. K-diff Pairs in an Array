class Solution {
    public int findPairs(int[] nums, int k) {
        int c=0;
        HashMap<Integer,Integer> map=new HashMap<>();
        for(int num:nums) map.put(num,map.getOrDefault(num,0)+1);
        for(int x:map.keySet()){
            if(k!=0){
                if(map.containsKey(x+k)) c++;
            }else{
                if(map.get(x)>=2) c++;
            }
        }
        return c;
    }
}
