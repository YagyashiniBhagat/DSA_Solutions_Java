class Solution {
    public int minimumDeletions(int[] nums) {
        int n=nums.length;
        int minidx=0,maxidx=0;
        for(int i=0;i<n;i++){
            if(nums[i]>maxi) maxidx=i;
            if(nums[i]<mini) minidx=i;
        }
        //scenario 1 deletion of both elements from the front
        int s1ans=0;
        if(maxidx > minidx) s1ans=maxidx+1;
        else s1ans=minidx+1;

        //scenario2 deletion of both elemnets from the back
        int s2ans=0;
        if(maxidx < minidx) s2ans=n-maxidx;
        else s2ans=n-minidx;

        //scenario 3 deletion of one element from the front and one from back
        int s3ans=0;
        if(minidx > maxidx){
            s3ans+=(n-minidx)+(maxidx+1);
        }else s3ans+=(n-maxidx)+(minidx+1);

        return Math.min(s1ans,Math.min(s2ans,s3ans));
    }
}
