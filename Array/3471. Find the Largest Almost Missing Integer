        //         largest=Math.max(largest,num);
        //     }
        //     return largest;
        // }
        // if(k==1){
        //     int ans=-1;
        //     for(int key:mp.keySet()){
        //         if(mp.get(key)==1) ans=Math.max(ans,key);
        //     }
