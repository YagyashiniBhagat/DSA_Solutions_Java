class Solution {
    int[] t;
    boolean solve(int n){
        if(n==0) return false;

        if(t[n]!=-1) return t[n]==1 ? true:false;

        for(int k=1;k*k <= n;k++){
            if(solve(n-(k*k)) == false){//call for bob, if false bob lost it
                t[n]=1;
                return true;
            }
        }
        t[n]=0;//alice could never win
        return false;
    }
    public boolean winnerSquareGame(int n) {
        t=new int[n+1];
        Arrays.fill(t,-1);
        return solve(n);//first call for alice if true alice wins else losts
    }
}
