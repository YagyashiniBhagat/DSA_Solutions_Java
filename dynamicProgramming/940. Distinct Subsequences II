class Solution {
    int[] dp=new int[2001];
    int[] prev;//last time we saw the nth char (1-based indexing)
    int M=1000000007;

    int solve(int n){
        if(n==0) return 1;
        if(dp[n]!=-1) return dp[n];

        int totsubs=(int)(2L * solve(n-1) % M);
        if(prev[n]!=0){
            int duplicates=solve(prev[n]-1);
            totsubs=(totsubs-duplicates + M)%M;
        }
        return dp[n]=totsubs;
    }
    public int distinctSubseqII(String s) {
        int n=s.length();
        Arrays.fill(dp,-1);
        prev=new int[n+1];
        int[] lastseen=new int[26];
        for(int i=1;i<=n;i++){
            int idx=s.charAt(i-1)-'a';
            prev[i]=lastseen[idx];
            lastseen[idx]=i;
        }
        return (solve(n)-1+M)%M;
    }
}
