class Solution {
    public int findMaxFork(Node root, int k) {
        // code here.
        //greatest value that is smaller than given element
        int floor=-1;
        while(root!=null){
            if(root.data==k){
                floor=root.data;
                return floor;
            }
            if(root.data < k){
                floor=root.data;
                root=root.right;
            }
            else root=root.left;
            floor=Math.max(floor,root.data);
        }
        return floor;
    }
}
