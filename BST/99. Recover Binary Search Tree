class Solution {
    TreeNode first;
    TreeNode prev;
    TreeNode middle;
    TreeNode second;

    void inorder(TreeNode root){
        if(root==null) return;
        inorder(root.left);

        if(prev!=null && root.val < prev.val){
            if(first==null){
                first=prev;
                middle=root;
            }else second=root;
        }

        prev=root;
        inorder(root.right);
    }

    public void recoverTree(TreeNode root) {
        first=middle=second=null;
        prev=new TreeNode(Integer.MIN_VALUE);
        inorder(root);
        if(first!=null && second!=null){
            int t=first.val;
            first.val=second.val;
            second.val=t;
        }
        else if(first!=null && middle!=null){//if the adjacent elements were swaped
            int t=first.val;
            first.val=middle.val;
            middle.val=t;
        }
    }
}
