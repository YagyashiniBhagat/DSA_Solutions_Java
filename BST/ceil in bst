class Solution {
    int findCeil(Node root, int x) {
        // code here
        //smallest value that is greater than equal to given val
        int ceil=-1;
        while(root!=null){
            if(root.data==x) return root.data;
            if(root.data > x){
                ceil=root.data;
                root=root.left;
            }
            else root=root.right;
        }
        return ceil;
    }
}
