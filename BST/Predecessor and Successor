class Solution {
    public ArrayList<Node> findPreSuc(Node root, int key) {
        // code here
        Node succ=null,pre=null;
        Node start=root;
        while(root!=null){
            if(root.data > key){
                succ=root;
                root=root.left;
            }else root=root.right;
        }
        while(start!=null){
            if(start.data < key){
                pre=start;
                start=start.right;
            }else start=start.left;
        }
        ArrayList<Node> ans=new ArrayList<>();
        ans.add(pre);
        ans.add(succ);
        return ans;
    }
}
