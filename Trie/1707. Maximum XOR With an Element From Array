class Node{
    Node links[]=new Node[2];

    boolean containskey(int bit){
        return links[bit]!=null;
    }

    Node get(int bit){
        return links[bit];
    }

    void put(int bit,Node node){
        links[bit]=node;
    }
}

class Trie{
    public static Node root;

    Trie(){
        root=new Node();
    }

    public void insert(int num){
        Node node=root;
        for(int i=31;i>=0;i--){
            int bit=(num>>i)&1;
            if(!node.containskey(bit)) node.put(bit,new Node());
            node=node.get(bit);
        }
    }

    public int getmaxxor(int num){
        Node node=root;
        int maxxor=0;
        for(int i=31;i>=0;i--){
            int bit=(num>>i)&1;
            if(node.containskey(1-bit)){
                maxxor=maxxor | (1<<i);//to turn on the bit
                node=node.get(1-bit);
            }
            else node=node.get(bit);
        }
        return maxxor;
    }
}
class Solution {
    public int[] maximizeXor(int[] nums, int[][] queries) {
        Arrays.sort(nums);
        int q=queries.length;
        int[] ans=new int[q];

        int[][] offlinequeries=new int[q][3];
        for(int i=0;i<q;i++){
            offlinequeries[i][0]=queries[i][1];//mi
            offlinequeries[i][1]=queries[i][0];//xi
            offlinequeries[i][2]=i;
        }

        Arrays.sort(offlinequeries, (a,b)-> a[0]-b[0]);//sort offlinequeries by mi
        Trie obj=new Trie();
        int idx=0,n=nums.length;
        for(int[] it:offlinequeries){
            int m=it[0], x=it[1], origidx=it[2];
            while(idx<n && nums[idx]<=m){
                obj.insert(nums[idx]);
                idx++;
            }
            if(idx!=0) ans[origidx]=obj.getmaxxor(x);
            else ans[origidx]=-1;
        }
        return ans;
    }
} 
